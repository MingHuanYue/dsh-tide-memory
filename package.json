{
  "name": "dsh-tide-memory",
  "version": "0.2.0",
  "description": "一份会忘事的长期记忆。该记的留着，没被想起来的自己淡掉；对不上号的两条不会并排塞给你看。本地跑，不联网，不多花一分钱。",
  "license": "MIT",
  "author": "MingHuanYue",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MingHuanYue/dsh-tide-memory.git"
  },
  "homepage": "https://github.com/MingHuanYue/dsh-tide-memory#readme",
  "bugs": {
    "url": "https://github.com/MingHuanYue/dsh-tide-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "ai-companion"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  }
}
